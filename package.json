{
  "name": "erodr-reconstruction",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @erodr/mobile run start --",
    "ios": "npm --workspace @erodr/mobile run ios",
    "android": "npm --workspace @erodr/mobile run android",
    "web": "npm --workspace @erodr/mobile run web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "@expo/vector-icons": "15.0.3",
    "expo": "54.0.36",
    "expo-font": "14.0.12",
    "expo-router": "6.0.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "engines": {
    "node": ">=22"
  }
}
